APP_NAME=auto-trader
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# PostgreSQL with pgvector support
DATABASE_URL=postgresql+asyncpg://autotrader:autotrader_secret@localhost:5432/autotrader

# Master AES-GCM encryption key (32 bytes)
MASTER_ENCRYPTION_KEY=autotrader_master_secret_key_32b!

# APScheduler timezone
SCHEDULER_TIMEZONE=Asia/Kolkata

# Logging
LOG_LEVEL=INFO
